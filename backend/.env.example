# ZeroHour Risk Engine — Environment Configuration
# Optional: Provide a Google Gemini API Key for live LLM narrative streaming.
# When omitted or offline, the engine automatically uses its deterministic,
# math-grounded quantitative risk fallback with full ethical guardrails enforced.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Feed Configuration ("equities" or "crypto")
DEFAULT_FEED_MODE=equities

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
